{
    "name": "pflege-de/laravel-keycloak-guard",
    "description": "🔑 Simple Keycloak Guard for Laravel",
    "keywords": [
        "laravel",
        "keycloak"
    ],
    "homepage": "https://github.com/webcarelbj/laravel-keycloak-guard",
    "license": "MIT",
    "authors": [
        {
            "name": "web care LBJ GmbH",
            "homepage": "https://pflege.de/",
            "role": "Maintainer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "illuminate/support": "^11.0 || ^12.0",
        "firebase/php-jwt": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "KeycloakGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KeycloakGuard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "php -d pcov.enabled=1 ./vendor/bin/pest --coverage --coverage-clover=.coverage/clover.xml --coverage-html=.coverage",
        "post-autoload-dump": [
            "@php ./vendor/bin/testbench package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "KeycloakGuard\\KeycloakGuardServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0",
        "friendsofphp/php-cs-fixer": "^3.10",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
